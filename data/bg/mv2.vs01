<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#d62976">
<title>AEC Digital Book</title>
<script src="https://cdn.jsdelivr.net/gh/caksup/aec@main/data/config.js"></script>
<script src="https://cdn.jsdelivr.net/gh/caksup/aec@main/data/recovery.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{--p:#10b981;--p2:#059669;--p3:#047857;--p-light:#d1fae5;--acc:#f59e0b;--danger:#ef4444;--bg:#f8fafc;--sf:#fff;--sf2:#f1f5f9;--tx:#0f172a;--tx2:#64748b;--tx3:#94a3b8;--bd:#e2e8f0;--bd2:#cbd5e1;--sh1:0 1px 2px rgba(15,23,42,.05);--sh2:0 4px 12px rgba(15,23,42,.08);--sh3:0 12px 32px rgba(15,23,42,.12);--sh4:0 24px 48px rgba(15,23,42,.16);--r:16px;--r-sm:10px;--r-lg:24px;--ig:linear-gradient(45deg,#feda75,#fa7e1e,#d62976,#962fbf,#4f5bd5)}
[data-theme=dark]{--bg:#0f172a;--sf:#1e293b;--sf2:#334155;--tx:#f1f5f9;--tx2:#94a3b8;--tx3:#64748b;--bd:#334155;--bd2:#475569}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--bg);color:var(--tx);line-height:1.5}
button{font-family:inherit;cursor:pointer;border:0;background:0;color:inherit}
input,textarea,select{font-family:inherit;color:var(--tx)}
@keyframes ig{0%{background-position:0 50%}50%{background-position:100% 50%}100%{background-position:0 50%}}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.35}}
@keyframes radar{0%{box-shadow:0 0 0 0 rgba(16,185,129,.55)}70%{box-shadow:0 0 0 10px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes pop{from{opacity:0;transform:scale(.5) translateY(10px)}to{opacity:1;transform:none}}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes slideup{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg)}}
@keyframes sk{to{background-position:-200% 0}}
@keyframes pl{0%,100%{transform:scale(1)}50%{transform:scale(1.08)}}
@keyframes pp{0%{transform:scale(1)}50%{transform:scale(1.3) rotate(10deg)}100%{transform:scale(1)}}
#splash{position:fixed;inset:0;z-index:99999;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;background:var(--ig);background-size:300% 300%;animation:ig 8s ease infinite;transition:opacity .8s}
#splash .logos{display:flex;gap:1rem;margin-bottom:1.2rem;min-height:80px;align-items:center}
#splash .logos img{height:80px;background:transparent;filter:drop-shadow(0 4px 14px rgba(0,0,0,.35));animation:pop 1s ease both}
#splash h1{font-size:1.4rem;font-weight:800;letter-spacing:3px}
#splash .tag{margin-top:.5rem;font-size:.66rem;opacity:.9;letter-spacing:2px}
#splash .bot{position:absolute;bottom:1.5rem;font-size:.6rem;opacity:.75}
#splash.hide{opacity:0;visibility:hidden}
#app{position:fixed;inset:0;z-index:9990;background:var(--bg);overflow-y:auto;-webkit-overflow-scrolling:touch}
.hdr{background:var(--ig);background-size:300% 300%;animation:ig 10s ease infinite;color:#fff;padding:.5rem .9rem;position:sticky;top:0;z-index:50;box-shadow:var(--sh3);transition:transform .3s}
.hdr.hide{transform:translateY(-100%)}
.hdr .r1{display:flex;justify-content:space-between;align-items:center;gap:.5rem}
.hdr .tt{display:flex;align-items:center;gap:.4rem;min-width:0;flex:1}
.hdr .tt img{width:30px;height:30px;border-radius:8px;background:transparent;flex-shrink:0}
.hdr .ttl-txt{font-weight:800;font-size:.8rem;letter-spacing:.4px;white-space:normal;line-height:1.15;text-align:left}
.hdr .acts{display:flex;gap:.3rem;align-items:center;flex-shrink:0}
.ib{background:rgba(255,255,255,.15);width:34px;height:34px;border-radius:11px;color:#fff;display:flex;align-items:center;justify-content:center}
.ib .material-icons-round{font-size:18px}
.ib:active .material-icons-round{animation:pp .4s}
.subhdr{background:var(--ig);background-size:300% 300%;animation:ig 10s ease infinite;color:#fff;padding:.3rem .9rem .5rem;text-align:center}
/* ===== UPDATED: time row ===== */
.time-row{font-size:.64rem;font-weight:600;opacity:.95;margin-bottom:.25rem;letter-spacing:.3px;display:flex;align-items:center;justify-content:center;gap:.3rem}
.time-row .material-icons-round{font-size:12px}
/* ===== UPDATED: greet row (greeting + nama di kanan) ===== */
.greet-row{display:flex;align-items:center;justify-content:center;gap:.5rem;margin-bottom:.35rem;flex-wrap:wrap}
.greet{font-size:.82rem;font-weight:700;opacity:1}
.greet-sep{opacity:.6;font-size:.7rem}
.greet-name{font-size:.82rem;font-weight:800;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:44vw;display:inline-flex;align-items:center;gap:.25rem;background:rgba(255,255,255,.18);padding:.18rem .55rem;border-radius:14px}
.chips{display:flex;gap:.3rem;justify-content:center;flex-wrap:wrap;font-size:.58rem}
.chip{background:rgba(255,255,255,.15);padding:.2rem .5rem;border-radius:16px;display:inline-flex;align-items:center;gap:.25rem;cursor:help}
.chip .material-icons-round{font-size:12px}
.ct{padding:.9rem;max-width:640px;margin:0 auto;padding-bottom:140px;animation:fadein .4s}
.bn{background:var(--ig);background-size:300% 300%;animation:ig 10s ease infinite;color:#fff;border-radius:var(--r);padding:.55rem .7rem;text-align:center;margin-bottom:.8rem;box-shadow:var(--sh2)}
.bn h3{font-size:.78rem;font-weight:700;margin-bottom:.3rem;line-height:1.3}
.bn .pills{display:flex;gap:.3rem;justify-content:center;flex-wrap:wrap}
.pill{display:inline-flex;align-items:center;gap:.25rem;background:rgba(255,255,255,.2);padding:.2rem .55rem;border-radius:18px;font-size:.62rem;font-weight:600}
.pill .material-icons-round{font-size:12px}
.subtab{display:flex;gap:.4rem;margin-bottom:.8rem;padding:.28rem;background:var(--sf2);border-radius:var(--r);border:1px solid var(--bd)}
.subtab button{flex:1;padding:.45rem .3rem;border-radius:var(--r-sm);font-size:.72rem;font-weight:600;color:var(--tx2);display:flex;align-items:center;justify-content:center;gap:.3rem}
.subtab button .material-icons-round{font-size:14px}
.subtab button.active{background:var(--sf);color:var(--p);box-shadow:var(--sh2);font-weight:700;animation:radar 1.6s infinite}
.sec-t{display:flex;align-items:center;gap:.5rem;font-size:.85rem;font-weight:700;margin:.8rem 0 .5rem}
.sec-t .material-icons-round{color:var(--p);font-size:18px}
.card{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:.85rem;box-shadow:var(--sh1);margin-bottom:.6rem;transition:all .25s;cursor:pointer}
.card.lk{opacity:.55}
.card h4{font-size:.8rem;font-weight:700;margin-bottom:.2rem;display:flex;align-items:center;gap:.4rem;line-height:1.25;min-height:2rem}
.card h4 .material-icons-round{color:var(--p);font-size:18px;flex-shrink:0}
.card .sub{font-size:.68rem;color:var(--tx2)}
.tag{background:var(--p-light);color:var(--p3);padding:.14rem .45rem;border-radius:10px;font-size:.62rem;font-weight:600;display:inline-block;margin:.1rem .12rem .1rem 0}
[data-theme=dark] .tag{background:rgba(16,185,129,.15)}
.tag.full{background:var(--p);color:#fff}
.grid{display:grid;grid-template-columns:1fr;gap:.6rem}
@media(min-width:520px){.grid{grid-template-columns:1fr 1fr}}
.skel{background:linear-gradient(90deg,var(--sf2) 25%,var(--bd) 50%,var(--sf2) 75%);background-size:200% 100%;animation:sk 1.4s infinite;border-radius:var(--r);height:80px}
.btn{width:100%;padding:.75rem;border-radius:var(--r-sm);background:var(--p);color:#fff;font-weight:700;font-size:.84rem;box-shadow:var(--sh2);display:inline-flex;align-items:center;justify-content:center;gap:.4rem;cursor:pointer;border:0}
.btn .material-icons-round{font-size:17px}
.btn.gh{background:var(--sf2);color:var(--tx);border:1px solid var(--bd);box-shadow:none}
.btn.dg{background:var(--danger);color:#fff}
.btn-row{display:flex;gap:.5rem}.btn-row .btn{flex:1}
.row{display:flex;justify-content:space-between;align-items:center;background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:.8rem;margin-bottom:.55rem}
.row.done{border-left:4px solid var(--p)}
.row-main{display:flex;align-items:center;gap:.7rem}
.row-main .material-icons-round{font-size:24px;color:var(--tx3)}
.row.done .row-main .material-icons-round{color:var(--p)}
.row-t{font-weight:700;font-size:.85rem}.row-s{font-size:.66rem;color:var(--tx2)}
.au{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r-lg);padding:1rem;box-shadow:var(--sh2);text-align:center;margin-bottom:.9rem}
.au .u{font-size:.66rem;color:var(--p);font-weight:700;text-transform:uppercase;letter-spacing:1px}
.au .p{font-size:1rem;font-weight:800;margin:.2rem 0 .6rem}
.done-ind{margin-top:.7rem;background:var(--p-light);color:var(--p3);padding:.6rem;border-radius:var(--r-sm);font-weight:700;font-size:.78rem;display:flex;align-items:center;justify-content:center;gap:.4rem}
.tts-line{transition:all .25s;border-radius:6px}
.tts-line.active{background:var(--p);color:#fff!important}
.tts-line.active td{color:#fff!important}
.vocab{width:100%;border-collapse:separate;border-spacing:0;font-size:.82rem;border-radius:var(--r-sm);overflow:hidden;border:1px solid var(--bd)}
.vocab th{background:var(--p-light);color:var(--p3);padding:.5rem .6rem;text-align:left;font-size:.64rem;font-weight:700;text-transform:uppercase}
.vocab td{padding:.5rem .6rem;border-bottom:1px solid var(--bd)}
.vocab tr:last-child td{border-bottom:0}
.vocab td:first-child{font-weight:700;color:var(--p)}
.vocab .ic{font-size:19px;color:var(--tx3);cursor:pointer;margin-right:.35rem;vertical-align:middle}
.vocab .ic.on{color:var(--p)}
.trans-box{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r);padding:.9rem;box-shadow:var(--sh1)}
.trans-t{display:flex;align-items:center;gap:.5rem;font-size:.78rem;font-weight:700;margin-bottom:.6rem;color:var(--tx2);padding-bottom:.45rem;border-bottom:2px solid var(--bd)}
/* ===== UPDATED: bnav dengan avatar di kanan ===== */
.bnav{position:fixed;bottom:0;left:0;right:0;z-index:9995;display:flex;background:var(--sf);border-top:1px solid var(--bd);padding:.4rem .3rem calc(.4rem + env(safe-area-inset-bottom));box-shadow:0 -8px 24px rgba(15,23,42,.08);align-items:center}
.bnav button{flex:1;color:var(--tx3);font-size:.58rem;font-weight:600;display:flex;flex-direction:column;align-items:center;gap:2px;padding:.3rem 0;border-radius:10px}
.bnav .material-icons-round{font-size:20px}
.bnav button.on{color:var(--p);animation:radar 1.6s infinite}
.bnav .nav-av{flex:0 0 auto;width:46px;height:46px;border-radius:50%;background:var(--p-light);display:flex;align-items:center;justify-content:center;font-size:1.4rem;cursor:pointer;border:2px solid var(--p);box-shadow:var(--sh2);margin-left:.4rem;transition:transform .2s;padding:0}
.bnav .nav-av:active{transform:scale(.92)}
#fbar{position:fixed;bottom:0;left:0;right:0;z-index:9996;display:flex;align-items:center;justify-content:center;gap:.7rem;padding:.6rem 1rem calc(.6rem + env(safe-area-inset-bottom));background:var(--sf);box-shadow:0 -8px 32px rgba(15,23,42,.12);border-top:1px solid var(--bd)}
#fbar .fbtn{width:52px;height:52px;border-radius:50%;color:#fff;background:linear-gradient(135deg,var(--p),var(--p2));display:flex;align-items:center;justify-content:center;box-shadow:var(--sh3)}
#fbar .fbtn .material-icons-round{font-size:24px}
#fbar .fbtn.sm{width:40px;height:40px;background:var(--sf2);color:var(--tx);box-shadow:var(--sh1);border:1px solid var(--bd)}
.rate-sel{padding:.5rem .6rem;border-radius:var(--r-sm);border:1px solid var(--bd);background:var(--sf2);color:var(--tx);font-weight:700;font-size:.8rem;cursor:pointer}
.ov{position:fixed;inset:0;background:rgba(15,23,42,.6);backdrop-filter:blur(8px);z-index:9997;display:none;align-items:center;justify-content:center;padding:1rem}
.ov.on{display:flex}
.mo{background:var(--sf);border-radius:var(--r-lg);padding:1.3rem;width:100%;max-width:440px;max-height:88vh;overflow-y:auto;box-shadow:var(--sh4);animation:slideup .35s}
.mo-t{display:flex;justify-content:space-between;align-items:center;margin-bottom:.9rem;font-weight:800;font-size:1rem}
.mo-t .ic{color:var(--p)}
.menu-item{display:flex;align-items:center;gap:.7rem;width:100%;padding:.75rem .9rem;border-radius:var(--r-sm);font-size:.86rem;font-weight:600;margin-bottom:.3rem}
.menu-item .material-icons-round{color:var(--p);font-size:19px}
.menu-item.dg{color:var(--danger)}.menu-item.dg .material-icons-round{color:var(--danger)}
.fb-row{display:flex;justify-content:center;gap:.8rem;margin:.8rem 0}
.fb-btn{font-size:2.3rem;background:var(--sf2);border:2px solid var(--bd);border-radius:var(--r);padding:.5rem 1rem}
#gm{position:fixed;inset:0;z-index:9998;background:#000;display:none;flex-direction:column}
#gm.on{display:flex}
#gm .h{display:flex;justify-content:flex-end;padding:.6rem;background:rgba(0,0,0,.7)}
#gm .h button{background:rgba(255,255,255,.15);color:#fff;width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center}
#gm iframe{flex:1;width:100%;border:0;background:#fff}
.mic{width:90px;height:90px;border-radius:50%;color:#fff;background:linear-gradient(135deg,var(--p),var(--p2));display:flex;align-items:center;justify-content:center;margin:1rem auto;box-shadow:var(--sh3)}
.mic .material-icons-round{font-size:2.4rem}
.mic.rec{background:linear-gradient(135deg,var(--danger),#dc2626);animation:pl 1.2s infinite}
.sr{display:flex;justify-content:space-between;background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r-sm);padding:.45rem .8rem;margin:.3rem 0;font-size:.78rem}
.sr b{color:var(--p)}
.live{min-height:46px;background:var(--sf2);border:1px dashed var(--bd2);border-radius:var(--r-sm);padding:.6rem;font-size:.86rem;margin:.6rem 0;text-align:center;display:flex;align-items:center;justify-content:center;gap:.4rem;color:var(--tx2)}
.cf{position:fixed;top:-12px;width:10px;height:14px;z-index:99999;pointer-events:none;border-radius:2px;animation:fall linear forwards}
#ofl{position:fixed;top:0;left:0;right:0;background:var(--acc);color:#fff;text-align:center;font-size:.7rem;font-weight:700;padding:.4rem;z-index:99999;display:none;align-items:center;justify-content:center;gap:.4rem}
#ofl.on{display:flex}
#dc-balloon{position:fixed;top:105px;right:12px;z-index:99994;background:var(--sf);border:2px solid var(--acc);border-radius:var(--r);padding:.55rem .75rem;box-shadow:var(--sh4);display:none;align-items:center;gap:.5rem;font-size:.74rem;font-weight:700;cursor:pointer;animation:pop .5s}
#dc-balloon.on{display:flex}
#dc-balloon .material-icons-round{color:var(--acc);font-size:19px}
#fab-focus{position:fixed;right:14px;top:50%;width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;z-index:99994;display:flex;align-items:center;justify-content:center;box-shadow:var(--sh4);cursor:grab;touch-action:none;user-select:none}
#fab-focus .material-icons-round{font-size:28px}
#fab-focus.run{animation:radar 1.2s infinite}
#fab-focus .ftxt{font-size:.72rem;font-weight:800}
#fab-focus.hid{display:none!important}
.ach-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(56px,1fr));gap:.3rem}
.ach{background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r-sm);padding:.45rem .15rem;text-align:center;font-size:.52rem;cursor:help;position:relative}
.ach .material-icons-round{font-size:1.1rem;color:var(--p);display:block;margin-bottom:.15rem}
.ach.lk{opacity:.3;filter:grayscale(.8)}
.flc{perspective:1000px;margin:1rem 0;height:170px;cursor:pointer}
.flc-in{position:relative;width:100%;height:100%;transform-style:preserve-3d;transition:transform .6s}
.flc.flipped .flc-in{transform:rotateY(180deg)}
.flc-f,.flc-b{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;border-radius:var(--r-lg);font-size:1.1rem;font-weight:700;backface-visibility:hidden;padding:1rem;text-align:center;box-shadow:var(--sh3)}
.flc-f{background:var(--sf);border:2px solid var(--bd)}
.flc-b{background:linear-gradient(135deg,var(--p),var(--p2));color:#fff;transform:rotateY(180deg)}
.av-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.6rem;margin:.7rem 0}
.av{background:var(--sf2);border:2px solid var(--bd);border-radius:50%;aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:1.7rem}
.av.sel{border-color:var(--p);background:var(--p-light);transform:scale(1.1)}
.lb{background:var(--sf);border:1px solid var(--bd);border-radius:var(--r-sm);padding:.55rem .8rem;display:flex;align-items:center;gap:.7rem;margin-bottom:.4rem}
.lb.me{border-left:3px solid var(--p)}
.lb .rk{font-weight:800;width:26px;color:var(--p)}
.lb .nm{flex:1;font-size:.82rem;font-weight:600;display:flex;align-items:center;gap:.4rem}
.lb .pt{font-size:.72rem;color:var(--tx2)}
.note-box{background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r);padding:.8rem;margin-top:.7rem}
.note-box textarea{width:100%;border:0;background:transparent;color:var(--tx);resize:none;min-height:56px;outline:none;font-size:.84rem}
.sb-word{background:var(--p-light);border:1px solid var(--p-light);border-radius:var(--r);padding:.85rem;text-align:center;margin-bottom:.85rem}
.sb-word b{font-size:1.2rem;color:var(--p);display:block}
.opt-btn{width:100%;text-align:left;background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r-sm);padding:.6rem .8rem;margin:.3rem 0;font-size:.86rem;font-weight:600;cursor:pointer}
.opt-btn.ok{border-color:var(--p);background:var(--p-light)}
.opt-btn.no{border-color:var(--danger);background:rgba(239,68,68,.1)}
.fold-row{display:flex;gap:.5rem;margin:.5rem 0;flex-wrap:wrap}
.fold-row .btn{flex:1;min-width:90px}
.ptabs{display:flex;gap:.4rem;margin-bottom:.9rem;padding:.28rem;background:var(--sf2);border-radius:var(--r);border:1px solid var(--bd)}
.ptabs button{flex:1;padding:.5rem .3rem;border-radius:var(--r-sm);font-size:.72rem;font-weight:600;color:var(--tx2);cursor:pointer;display:flex;align-items:center;justify-content:center;gap:.3rem;border:0;background:transparent}
.ptabs button .material-icons-round{font-size:14px}
.ptabs button.active{background:var(--sf);color:var(--p);box-shadow:var(--sh2);font-weight:700;animation:radar 1.6s infinite}
.hid{display:none!important}
.tc{text-align:center}.tx-m{color:var(--tx2)}.mb{margin-bottom:.85rem}
#app{z-index:99990!important}
.bnav{z-index:99991!important}
#fbar{z-index:99992!important}
.ov{z-index:99995!important}
#gm{z-index:99996!important}
#ofl{z-index:99998!important}
.compact-hdr{background:var(--ig);background-size:300% 300%;animation:ig 10s ease infinite;color:#fff;border-radius:var(--r);padding:.55rem .7rem;margin-bottom:.8rem;box-shadow:var(--sh2);display:flex;align-items:center;gap:.5rem}
.compact-hdr .ib{background:rgba(255,255,255,.18);width:32px;height:32px;border-radius:50%}
.compact-hdr h3{margin:0;flex:1;text-align:left;font-size:.88rem;font-weight:700;line-height:1.2}
.bm-card{background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r-sm);padding:.6rem .7rem;margin-bottom:.4rem;display:flex;justify-content:space-between;align-items:center}
.bm-card b{color:var(--p);font-size:.85rem}
.bm-card .tx-m{font-size:.72rem;color:var(--tx2)}
.bm-card .acts{display:flex;gap:.3rem}
.load-state{text-align:center;padding:2rem 1rem;color:var(--tx2);font-size:.82rem;grid-column:1/-1}
.load-state .material-icons-round{font-size:2.2rem;color:var(--p);display:block;margin-bottom:.5rem;animation:spin 1.5s linear infinite}
.err-state{text-align:center;padding:1.5rem 1rem;color:var(--danger);font-size:.82rem;background:#fee2e2;border-radius:var(--r);margin:.5rem 0;grid-column:1/-1}
.err-state .material-icons-round{font-size:2rem;display:block;margin-bottom:.3rem}
.err-state code{display:block;background:#fff;padding:.4rem;border-radius:6px;font-size:.7rem;color:var(--tx);margin-top:.4rem;word-break:break-all}
/* Profile meta dengan icon separator */
.pf-meta-row{display:flex;align-items:center;justify-content:center;gap:.4rem;color:var(--tx2);font-size:.78rem;font-weight:600;margin-bottom:.6rem}
.pf-meta-row .material-icons-round{font-size:14px;color:var(--tx3)}
</style>
</head>
<body>
<div id="splash"><div class="logos"><img id="lg1" src=""><img id="lg2" src=""></div><h1>AEC DIGITAL BOOK</h1><div class="tag">ENGLISH LEARNING PLATFORM</div><div class="bot">AEC 2026 • v4.9 • Jagat Kreatif</div></div>
<div id="ofl"><span class="material-icons-round">wifi_off</span> Offline</div>
<div id="dc-balloon" onclick="openProfile();this.classList.remove('on')"><span class="material-icons-round">emoji_events</span> Daily Challenge!</div>
<button id="fab-focus" title="Focus Learn"><span class="material-icons-round" id="fab-ic">timer</span><span class="ftxt hid" id="fab-tx"></span></button>

<div id="app">
 <header class="hdr" id="hdr">
  <div class="r1">
   <div class="tt"><img id="h-logo1" src=""><img id="h-logo2" src=""><span class="ttl-txt">AEC DIGITAL BOOK</span></div>
   <div class="acts">
    <button class="ib" onclick="toggleFullscreen()" title="Fullscreen"><span class="material-icons-round" id="fs-icon">fullscreen</span></button>
    <button class="ib" onclick="toggleTheme()" title="Theme"><span class="material-icons-round" id="thi">dark_mode</span></button>
    <button class="ib" onclick="toggleLang()" title="Language"><span class="material-icons-round">public</span></button>
    <button class="ib" onclick="openMenu()"><span class="material-icons-round">more_vert</span></button>
   </div>
  </div>
 </header>
 <div class="subhdr">
  <!-- UPDATED: Time row (hari English + jam WIB) -->
  <div class="time-row" id="time-row">
   <span class="material-icons-round">schedule</span>
   <span id="time-display">—</span>
  </div>
  <!-- UPDATED: Greet row (greeting + nama di kanan) -->
  <div class="greet-row">
   <span class="greet" id="greet">Good morning!</span>
   <span class="greet-sep">|</span>
   <span class="greet-name" onclick="openProfile()" id="c-n"><span class="material-icons-round" style="font-size:14px">person</span> —</span>
  </div>
  <div class="chips">
   <span class="chip" title="ID Siswa"><span class="material-icons-round">badge</span><span id="c-i">-</span></span>
   <span class="chip" title="Kelas"><span class="material-icons-round">school</span><span id="c-c">-</span></span>
   <span class="chip" title="Sisa durasi akses"><span class="material-icons-round">schedule</span><span id="c-d">-</span></span>
   <span class="chip" title="Progress materi selesai"><span class="material-icons-round">flag</span><span id="p-prog-t">0/0</span></span>
   <span class="chip" title="Games terbuka hari ini"><span class="material-icons-round">sports_esports</span><span id="p-game-t">0/10</span></span>
   <span class="chip" title="Streak belajar harian"><span class="material-icons-round">local_fire_department</span><span id="p-stk-t">0</span></span>
  </div>
 </div>

 <div id="sc-login" class="ct hid" style="display:flex;align-items:center;justify-content:center;min-height:90vh">
  <div class="card tc" style="max-width:400px;width:100%;padding:1.7rem">
   <div style="width:72px;height:72px;border-radius:50%;background:var(--p-light);display:flex;align-items:center;justify-content:center;margin:0 auto 1rem"><span class="material-icons-round" style="font-size:2.3rem;color:var(--p)">headphones</span></div>
   <h3 style="margin-bottom:.25rem;font-size:1.2rem" data-i18n="welcome">Welcome Back</h3>
   <p class="tx-m mb" style="font-size:.82rem" data-i18n="enter_idpin">Sign in to continue</p>
   <input id="in-id" class="btn gh mb" placeholder="Student ID">
   <input id="in-pin" type="password" class="btn gh mb" placeholder="PIN" maxlength="6">
   <button class="btn" onclick="login()"><span class="material-icons-round">login</span> <span data-i18n="sign_in">SIGN IN</span></button>
   <p id="err" style="color:var(--danger);font-size:.78rem;display:none;margin-top:.7rem">ID or PIN incorrect</p>
   <p id="err-load" style="color:var(--danger);font-size:.72rem;display:none;margin-top:.7rem"></p>
  </div>
 </div>

 <div id="sc-learn" class="ct hid">
  <div class="bn"><h3 id="wl">Hello!</h3></div>
  <div class="subtab" id="learn-tabs">
   <button class="active" data-tab="vocab" onclick="setLearnTab('vocab',this)"><span class="material-icons-round">translate</span> Vocabulary</button>
   <button data-tab="speaking" onclick="setLearnTab('speaking',this)"><span class="material-icons-round">record_voice_over</span> Speaking</button>
   <button data-tab="grammar" onclick="setLearnTab('grammar',this)"><span class="material-icons-round">edit_note</span> Grammar</button>
  </div>
  <div id="learn-vocab">
   <div class="subtab">
    <button class="active" onclick="vocabSub('units',this)"><span class="material-icons-round">folder</span> Units</button>
    <button onclick="vocabSub('table',this)"><span class="material-icons-round">table_view</span> Table</button>
   </div>
   <div id="vocab-units"><div class="grid" id="vocab-units-grid"></div></div>
   <div id="vocab-table" class="hid"><div class="trans-box"><div id="vocab-box"></div></div></div>
  </div>
  <div id="learn-speaking" class="hid"><div class="grid" id="grid-speaking"></div></div>
  <div id="learn-grammar" class="hid"><div class="grid" id="grid-grammar"></div></div>
 </div>

 <div id="sc-practice" class="ct hid">
  <div class="bn"><h3><span class="material-icons-round" style="vertical-align:middle">quiz</span> Practice</h3></div>
  <div class="subtab" id="prac-tabs">
   <button class="active" onclick="pracTab('vocab',this)"><span class="material-icons-round">translate</span> Vocab</button>
   <button onclick="pracTab('speaking',this)"><span class="material-icons-round">record_voice_over</span> Speaking</button>
   <button onclick="pracTab('grammar',this)"><span class="material-icons-round">edit_note</span> Grammar</button>
  </div>
  <div id="prac-vocab" class="grid"></div>
  <div id="prac-speaking" class="grid hid"></div>
  <div id="prac-grammar" class="grid hid"></div>
  <div style="margin-top:1.1rem"><div class="sec-t"><span class="material-icons-round">leaderboard</span> Leaderboard</div><div id="lb-box"></div></div>
 </div>

 <div id="sc-sp" class="ct hid">
  <div class="bn"><h3><span class="material-icons-round" style="vertical-align:middle">mic</span> Speak Live</h3><div class="pills"><span class="pill" id="sp-kem"><span class="material-icons-round">grade</span> B</span></div></div>
  <div class="subtab"><button onclick="setKem('A',this)">A</button><button class="active" onclick="setKem('B',this)">B</button><button onclick="setKem('C',this)">C</button></div>
  <div class="card" style="cursor:default">
   <div class="tc" id="sp-target" style="font-size:1.05rem;font-weight:700;margin:.5rem 0">...</div>
   <div class="tc tx-m" id="sp-focus" style="font-size:.72rem;margin-bottom:.4rem"></div>
   <div class="live" id="sp-live"><span class="material-icons-round">mic</span> Tap mic and speak</div>
   <button class="mic" id="sp-mic" onclick="tapMic()"><span class="material-icons-round">mic</span></button>
   <div id="sp-res" class="hid"></div>
   <button class="btn" onclick="nextSpeak()" style="margin-top:.7rem"><span class="material-icons-round">arrow_forward</span> Next</button>
  </div>
 </div>

 <div id="sc-extra" class="ct hid">
  <div class="bn"><h3><span class="material-icons-round" style="vertical-align:middle">language</span> Extra</h3><div class="pills"><span class="pill" id="ex-un"><span class="material-icons-round">lock</span> 0/10</span></div></div>
  <div class="subtab">
   <button class="active" onclick="extraTab('tools',this)"><span class="material-icons-round">language</span> English Tools</button>
   <button onclick="extraTab('games',this)"><span class="material-icons-round">sports_esports</span> Games</button>
  </div>
  <div id="extra-tools"><div class="grid" id="tools-grid"></div></div>
  <div id="extra-games" class="hid"><div class="grid" id="exgrid"></div></div>
 </div>

 <div id="sc-mcq" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#practice')"><span class="material-icons-round">arrow_back</span></button><h3>Multiple Choice Quiz</h3></div>
  <div class="bn"><div class="pills"><span class="pill" id="mcq-prog">0/0</span><span class="pill" id="mcq-score">0</span></div></div>
  <div class="card" style="cursor:default"><div class="tc" id="mcq-q" style="font-size:1.1rem;font-weight:700;margin:.6rem 0">...</div><div id="mcq-opts"></div></div>
 </div>
 <div id="sc-listen" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Listening</h3></div>
  <div class="bn"><div class="pills"><span class="pill" id="ls-prog">0/0</span></div></div>
  <div class="card" style="cursor:default"><button class="mic" onclick="playListen()" style="margin:.5rem auto"><span class="material-icons-round">volume_up</span></button><div class="tc tx-m mb">Tap speaker, choose meaning</div><div id="ls-opts"></div></div>
 </div>
 <div id="sc-scramble" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Word Scramble</h3></div>
  <div class="bn"><div class="pills"><span class="pill" id="sc-prog">0/0</span></div></div>
  <div class="card" style="cursor:default"><div class="sb-word"><b id="sc-word">?????</b><span id="sc-mean" class="tx-m"></span></div><input id="sc-in" class="btn gh mb" placeholder="Type the correct word"><button class="btn" onclick="checkScramble()"><span class="material-icons-round">check</span> Check</button><button class="btn gh" onclick="nextScramble()" style="margin-top:.5rem"><span class="material-icons-round">refresh</span> Next</button></div>
 </div>
 <div id="sc-sentence" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Sentence Builder</h3></div>
  <div class="sb-word"><b id="sb-word">eat</b><span id="sb-mean">makan</span></div>
  <div class="card" style="cursor:default"><textarea id="sb-in" rows="3" placeholder="e.g. he eat rice" style="width:100%;border:1px solid var(--bd);border-radius:var(--r-sm);background:var(--sf2);padding:.7rem;margin:.5rem 0;outline:none"></textarea><button class="btn" onclick="checkSent()"><span class="material-icons-round">fact_check</span> Check</button><div id="sb-res" class="hid" style="margin-top:.85rem"></div><button class="btn gh" onclick="pickSent()" style="margin-top:.6rem"><span class="material-icons-round">refresh</span> Next Word</button></div>
 </div>
 <div id="sc-dict" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Dictionary</h3></div>
  <input id="dict-in" class="btn gh mb" placeholder="Search word..." oninput="renderDict()">
  <div class="trans-box"><div id="dict-box"></div></div>
 </div>
 <div id="sc-flash" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Flashcards</h3></div>
  <div class="bn"><div class="pills"><span class="pill" id="fl-prog">0/0</span></div></div>
  <div class="flc" id="flc" onclick="flipFlash()"><div class="flc-in"><div class="flc-f" id="fl-f"></div><div class="flc-b" id="fl-b"></div></div></div>
  <div class="btn-row"><button class="btn gh" onclick="flashPrev()"><span class="material-icons-round">arrow_back</span></button><button class="btn" onclick="flashNext()"><span class="material-icons-round">arrow_forward</span></button></div>
 </div>
 <div id="sc-mem" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#extra')"><span class="material-icons-round">arrow_back</span></button><h3>Memorize it</h3></div>
  <div class="card" style="cursor:default">
   <div class="form-group" style="margin-bottom:.5rem"><label style="font-size:.72rem;font-weight:700;color:var(--tx2)">Template kalimat (pilih dari speaking)</label><select id="mem-tmpl" onchange="memPickTmpl()" class="btn gh" style="width:100%;text-align:left"></select></div>
   <div class="form-group" style="margin-bottom:.5rem"><label style="font-size:.72rem;font-weight:700;color:var(--tx2)">Atau tulis manual</label><textarea id="mem-txt" rows="3" class="btn gh" style="width:100%;text-align:left;resize:vertical" placeholder="Type sentence to memorize..."></textarea></div>
   <button class="btn mb" onclick="memStart()"><span class="material-icons-round">psychology</span> Start Memorize</button>
   <div id="mem-play" class="hid">
    <div style="background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r);padding:1rem;margin:.5rem 0">
     <div style="display:flex;justify-content:space-between;margin-bottom:.5rem"><b style="color:var(--p)">Step 1: Read & Listen</b><button class="ib" style="background:var(--sf);color:var(--tx);width:32px;height:32px" onclick="memSpeak()"><span class="material-icons-round" style="font-size:16px">volume_up</span></button></div>
     <div id="mem-show" style="background:#fff;border:1px solid var(--bd);border-radius:var(--r-sm);padding:1rem;font-size:1rem;line-height:1.6;min-height:60px;margin:.5rem 0"></div>
     <button class="btn gh" onclick="memStep2()"><span class="material-icons-round">visibility_off</span> Hide & Type</button>
    </div>
    <div class="hid" id="mem-step2" style="background:var(--sf2);border:1px solid var(--bd);border-radius:var(--r);padding:1rem">
     <b style="color:var(--p)">Step 2: Type from memory</b>
     <input id="mem-in" style="width:100%;padding:.7rem;border:1px solid var(--bd);border-radius:var(--r-sm);background:var(--sf);font-size:.9rem;margin:.5rem 0" placeholder="Type what you remember...">
     <button class="btn" onclick="memCheck()"><span class="material-icons-round">check_circle</span> Check</button>
     <div id="mem-res" style="margin-top:.8rem"></div>
     <button class="btn gh" onclick="memRestart()" style="margin-top:.5rem"><span class="material-icons-round">refresh</span> Try Again</button>
    </div>
   </div>
  </div>
 </div>

 <div id="sc-unit" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#learn')"><span class="material-icons-round">arrow_back</span></button><h3 id="u-title" style="flex:1;font-size:.88rem">-</h3></div>
  <div id="u-parts"></div>
 </div>
 <div id="sc-player" class="ct hid">
  <div class="compact-hdr"><button class="ib" onclick="go('#unit/'+curUnit)"><span class="material-icons-round">arrow_back</span></button><div style="flex:1;text-align:left"><div style="font-size:.64rem;opacity:.85;text-transform:uppercase;letter-spacing:1px" id="pl-u">-</div><div style="font-size:.92rem;font-weight:800" id="pl-p">-</div></div></div>
  <div class="au"><div id="tts-prog" class="tx-m" style="font-size:.76rem"></div><div id="pl-done" class="hid done-ind"><span class="material-icons-round">check_circle</span> Done!</div></div>
  <div class="trans-box"><div class="trans-t"><span class="material-icons-round">auto_stories</span> Material</div><div id="pl-txt" style="font-size:.88rem;line-height:1.8">...</div></div>
  <div class="note-box"><div class="lab tx-m" style="font-weight:700;font-size:.7rem;margin-bottom:.4rem"><span class="material-icons-round" style="font-size:14px;color:var(--p)">edit_note</span> MY NOTES</div><textarea id="note-ta" placeholder="Write notes..." oninput="saveNote()"></textarea></div>
 </div>
</div>

<!-- UPDATED: bnav dengan avatar di kanan Extra -->
<nav class="bnav" id="bnav">
 <button class="on" onclick="go('#learn',this)"><span class="material-icons-round">menu_book</span><span data-i18n="learn">Learn</span></button>
 <button onclick="go('#practice',this)"><span class="material-icons-round">quiz</span><span data-i18n="practice">Practice</span></button>
 <button onclick="go('#sp',this)"><span class="material-icons-round">mic</span><span data-i18n="speak">Speak</span></button>
 <button onclick="go('#extra',this)"><span class="material-icons-round">language</span><span data-i18n="extra">Extra</span></button>
 <button class="nav-av" id="nav-av" onclick="openProfile()" title="My Profile">🦁</button>
</nav>

<div id="fbar" class="hid">
 <button class="fbtn sm" onclick="floatStop()"><span class="material-icons-round">stop</span></button>
 <button class="fbtn" onclick="floatToggle()"><span class="material-icons-round" id="f-icon">play_arrow</span></button>
 <select id="tts-rate" class="rate-sel" onchange="setRate(this.value)" title="Kecepatan TTS">
  <option value="0.7" selected>Slow</option>
  <option value="1">Normal</option>
  <option value="1.3">Fast</option>
 </select>
</div>

<div class="ov" id="ov-focus"><div class="mo tc">
 <div class="mo-t"><span class="material-icons-round ic">timer</span> Focus Learn <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="stopFocus()"><span class="material-icons-round">close</span></button></div>
 <div style="font-size:3rem;color:var(--p)">🎯</div>
 <h3 style="margin:.4rem 0">Mari Fokus Belajar</h3>
 <p class="tx-m mb" style="font-size:.84rem">Matikan gangguan, fokus 25 menit. Layar akan penuh otomatis & tombol back dikunci.</p>
 <button class="btn" id="focus-play" onclick="pomoStart()"><span class="material-icons-round">play_arrow</span> Play</button>
 <button class="btn gh" onclick="pomoReset()" style="margin-top:.5rem"><span class="material-icons-round">restart_alt</span> Reset</button>
</div></div>

<div class="ov" id="ov-locked"><div class="mo tc">
 <div class="mo-t"><span class="material-icons-round ic">lock</span> <span id="locked-title">Terkunci</span> <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="closeOv('ov-locked')"><span class="material-icons-round">close</span></button></div>
 <div style="font-size:3rem;color:var(--acc)">🔒</div>
 <p id="locked-msg" class="tx-m mb" style="font-size:.9rem;font-weight:600">Selesaikan materi untuk membuka.</p>
 <button class="btn" onclick="closeOv('ov-locked');go('#learn')">📚 Belajar Dulu</button>
</div></div>

<div class="ov" id="ov-profile"><div class="mo">
 <div class="mo-t"><span class="material-icons-round ic">person</span> My Profile <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="closeOv('ov-profile')"><span class="material-icons-round">close</span></button></div>
 <div class="tc"><button onclick="profTab('avatar')" style="font-size:4rem;background:none;border:none;cursor:pointer" id="pf-av">🦁</button></div>
 <div class="tc" style="font-weight:800;font-size:1rem" id="pf-name">-</div>
 <!-- UPDATED: meta row dengan icon separator (tanpa bullet) -->
 <div class="pf-meta-row">
  <span class="material-icons-round">badge</span>
  <span id="pf-id">-</span>
  <span class="material-icons-round">circle</span>
  <span class="material-icons-round">school</span>
  <span id="pf-class">-</span>
 </div>
 <div class="ptabs">
  <button class="active" onclick="profTab('data',this)"><span class="material-icons-round">person</span> Data Profil</button>
  <button onclick="profTab('ach',this)"><span class="material-icons-round">emoji_events</span> Achievements</button>
  <button onclick="profTab('avatar',this)"><span class="material-icons-round">face</span> Avatar</button>
 </div>
 <div id="pf-data">
  <div class="sr" id="pf-dc"><span>Daily Challenge</span><b>-</b></div>
  <div class="sr"><span>Login Streak</span><b id="pf-login">0</b></div>
  <div class="sr"><span>Study Streak</span><b id="pf-daily">0</b></div>
  <div class="sr"><span>Parts Done</span><b id="pf-parts">0</b></div>
  <div style="font-size:.74rem;font-weight:700;margin:.8rem 0 .4rem">Bookmarks (per materi)</div>
  <div class="fold-row"><button class="btn gh" onclick="openBmFolder('vocabulary')">Vocabulary</button><button class="btn gh" onclick="openBmFolder('speaking')">Speaking</button><button class="btn gh" onclick="openBmFolder('grammar')">Grammar</button></div>
  <div style="font-size:.74rem;font-weight:700;margin:.8rem 0 .4rem">My Notes (per materi)</div>
  <div class="fold-row"><button class="btn gh" onclick="openNoteFolder('vocabulary')">Vocabulary</button><button class="btn gh" onclick="openNoteFolder('speaking')">Speaking</button><button class="btn gh" onclick="openNoteFolder('grammar')">Grammar</button></div>
 </div>
 <div id="pf-ach" class="hid"><div class="ach-grid" id="pf-ach-grid"></div></div>
 <div id="pf-avatar" class="hid"><div class="av-grid" id="pf-grid"></div></div>
</div></div>

<div class="ov" id="ov-bmfold"><div class="mo">
 <div class="mo-t"><span class="material-icons-round ic">bookmark</span> <span id="bmfold-title">Bookmarks</span> <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="closeOv('ov-bmfold')"><span class="material-icons-round">close</span></button></div>
 <div id="bmfold-body"></div>
</div></div>
<div class="ov" id="ov-notefold"><div class="mo">
 <div class="mo-t"><span class="material-icons-round ic">edit_note</span> <span id="notefold-title">Notes</span> <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="closeOv('ov-notefold')"><span class="material-icons-round">close</span></button></div>
 <div id="notefold-body"></div>
</div></div>

<div class="ov" id="ov-menu"><div class="mo">
 <div class="mo-t"><span class="material-icons-round ic">menu</span> Menu <button class="ib" style="background:var(--sf2);color:var(--tx)" onclick="closeOv('ov-menu')"><span class="material-icons-round">close</span></button></div>
 <button class="menu-item" onclick="closeOv('ov-menu');openGuide()"><span class="material-icons-round">menu_book</span> Guide</button>
 <button class="menu-item" onclick="closeOv('ov-menu');openReport()"><span class="material-icons-round">report_problem</span> Report</button>
 <button class="menu-item" onclick="closeOv('ov-menu');openOnb()"><span class="material-icons-round">info</span> Onboarding</button>
 <button class="menu-item" onclick="closeOv('ov-menu');forceRefresh()"><span class="material-icons-round">refresh</span> Refresh Data</button>
 <button class="menu-item dg" onclick="closeOv('ov-menu');openLogout()"><span class="material-icons-round">logout</span> Log Out</button>
</div></div>
