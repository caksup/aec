 <div id="rc1"><div style="font-weight:800;margin-bottom:.9rem">How was this lesson?</div>
  <div class="fb-row"><button class="fb-btn" onclick="react('happy')"><span class="material-icons-round" style="font-size:2rem">sentiment_satisfied</span></button><button class="fb-btn" onclick="react('mid')"><span class="material-icons-round" style="font-size:2rem">sentiment_neutral</span></button><button class="fb-btn" onclick="react('sad')"><span class="material-icons-round" style="font-size:2rem">sentiment_dissatisfied</span></button></div></div>
